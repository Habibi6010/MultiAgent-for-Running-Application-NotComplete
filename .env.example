# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials to version control.

# At least one LLM provider key is required.
# Preferred by the controller when both are configured.
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional Supabase configuration for conversation persistence.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional user identifier. If omitted, the application prompts for one
# and uses "anonymous" when no value is provided.
USER_ID=your_user_id_here
